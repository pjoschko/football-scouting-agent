    {
      "id": "d8a7f705-79f5-4aa0-86e1-02cebb543acc",
      "name": "Review-Entscheidung auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8912,
        2064
      ],
      "parameters": {
        "jsCode": "const MAX_REVIEW_ROUNDS = 3;\n\nconst submitted = $input.item.json;\nconst original = $('Execute Workflow: Scouting Brief erstellen').first().json;\n\nconst reviewDecision = (submitted['Entscheidung'] || '').toString().trim();\nconst reviewFeedback = (submitted['Feedback (Pflicht bei Request Changes)'] || '').toString().trim();\n\nconst errors = [];\n\nif (!['Approve', 'Request Changes', 'Reject'].includes(reviewDecision)) {\n  errors.push('Unbekannte Review-Entscheidung: ' + reviewDecision);\n}\n\nif (reviewDecision === 'Request Changes' && !reviewFeedback) {\n  errors.push('Fuer \"Request Changes\" ist ein Feedback-Text erforderlich.');\n}\n\nif (errors.length > 0) {\n  throw new Error(\n    'Die Review-Entscheidung ist ungueltig.\\n\\n' + errors.join('\\n')\n  );\n}\n\nconst reviewRound =\n  (original.scoutingBrief && original.scoutingBrief.reviewRound) || 1;\n\nconst maxRoundsReached =\n  reviewDecision === 'Request Changes' &&\n  reviewRound >= MAX_REVIEW_ROUNDS;\n\nconst reviewOutcome =\n  maxRoundsReached ? 'Reject' : reviewDecision;\n\nreturn [{\n  json: {\n    ...original,\n    reviewDecision,\n    reviewFeedback,\n    reviewOutcome,\n    maxRoundsReached\n  }\n}];"
      }
    },
