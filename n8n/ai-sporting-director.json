    {
      "parameters": {
        "formTitle": "Scouting Brief zur Freigabe",
        "formDescription": "=Verein: {{ $json.club }}\n\nHauptproblem (Teamdiagnose): {{ $json.scoutingBrief.problem }}\n\nZielposition / Rolle: {{ $json.scoutingBrief.targetPosition }} / {{ $json.scoutingBrief.role }}\n\nBegruendung: {{ $json.scoutingBrief.reasoning }}\n\nGewichtete Kriterien: {{ $json.scoutingBrief.weightedCriteria.map(c => c.criterion + ' (' + c.weight + ')').join(', ') }}\n\nConstraints: {{ $json.scoutingBrief.constraints.length ? $json.scoutingBrief.constraints.map(c => c.field + ' ' + c.operator + ' ' + c.value).join(', ') : '(keine)' }}\n\nUnsicherheiten: {{ $json.scoutingBrief.uncertainties.join('; ') }}\n\nUeberarbeitungsrunde: {{ $json.scoutingBrief.reviewRound }} von max. {{ $json.scoutingBrief.maxReviewRounds }}{{ $json.scoutingBrief.feedbackHistory.length ? ('\\n\\nBisheriges Feedback: ' + $json.scoutingBrief.feedbackHistory.map(f => 'Runde ' + f.round + ': ' + f.feedback).join(' | ')) : '' }}",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Entscheidung",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Approve"
                  },
                  {
                    "option": "Request Changes"
                  },
                  {
                    "option": "Reject"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Feedback (Pflicht bei Request Changes)",
              "fieldType": "textarea",
              "requiredField": false
            }
          ]
        },
        "options": {
          "buttonLabel": "Entscheidung uebermitteln"
        }
      },
      "id": "b1a2c3d4-5004-4a11-9001-aa1122334404",
      "name": "Scouting Brief zur Freigabe vorlegen",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const MAX_REVIEW_ROUNDS = 3;\nconst submitted = $input.item.json;\nconst original = $('Execute Workflow: Scouting Brief erstellen').first().json;\n\nconst reviewDecision = (submitted['Entscheidung'] || '').toString().trim();\nconst reviewFeedback = (submitted['Feedback (Pflicht bei Request Changes)'] || '').toString().trim();\n\nconst errors = [];\nif (!['Approve', 'Request Changes', 'Reject'].includes(reviewDecision)) {\n  errors.push('Unbekannte Review-Entscheidung: ' + reviewDecision);\n}\nif (reviewDecision === 'Request Changes' && !reviewFeedback) {\n  errors.push('Fuer \"Request Changes\" ist ein Feedback-Text erforderlich.');\n}\n\nconst reviewRound = (original.scoutingBrief && original.scoutingBrief.reviewRound) || 1;\nconst maxRoundsReached = reviewDecision === 'Request Changes' && reviewRound >= MAX_REVIEW_ROUNDS;\n// Ein begrenzter Feedback-Loop (siehe n8n/README.md): nach MAX_REVIEW_ROUNDS\n// Ueberarbeitungen wird eine weitere 'Request Changes' nicht mehr akzeptiert,\n// sondern wie ein 'Reject' kontrolliert beendet, statt endlos weiter zu ueberarbeiten.\nconst reviewOutcome = maxRoundsReached ? 'Reject' : reviewDecision;\n\nconst valid = errors.length === 0;\n\nreturn [{\n  json: {\n    ...original,\n    reviewDecision,\n    reviewFeedback,\n    reviewOutcome,\n    maxRoundsReached,\n    valid,\n    errorMessage: valid\n      ? undefined\n      : 'Die Review-Entscheidung ist ungueltig.\\n\\n' + errors.join('\\n')\n  }\n}];"
      },
      "id": "b1a2c3d4-5005-4a11-9001-aa1122334405",
      "name": "Review-Entscheidung auswerten",
      "type": "n8n-nodes-base.code",
