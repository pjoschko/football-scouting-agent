    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst reason = item.maxRoundsReached\n  ? `Die maximale Anzahl von ${item.scoutingBrief.maxReviewRounds} Ueberarbeitungsrunden fuer das Scouting Brief ist erreicht worden.`\n  : 'Der Sporting Director hat das Scouting Brief abgelehnt (Reject).';\nconst feedback = item.reviewFeedback ? `\\n\\nFeedback: ${item.reviewFeedback}` : '';\n\nreturn [{\n  json: {\n    ...item,\n    errorMessage: `Die Kandidatensuche wurde nach der Human-Review kontrolliert beendet.\\n\\n${reason}${feedback}`\n  }\n}];"
      },
