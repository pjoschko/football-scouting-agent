      "parameters": {
        "jsCode": "const item=$input.item.json;\nconst reason=item.maxRoundsReached?`Die maximale Anzahl von ${item.scoutingBrief.maxReviewRounds} Ueberarbeitungsrunden fuer das Scouting Brief ist erreicht worden.`:'Der Sporting Director hat das Scouting Brief abgelehnt (Reject).';\nconst feedback=item.reviewFeedback?`\\n\\nFeedback: ${item.reviewFeedback}`:'';\nreturn [{json:{...item,errorMessage:`Die Kandidatensuche wurde nach der Human-Review kontrolliert beendet.\\n\\n${reason}${feedback}`}}];"
