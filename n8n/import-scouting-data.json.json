    {
      "id": "fd9dadac-c05a-4477-b6b7-a515f9cb8232",
      "name": "Match-Daten validieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        48
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json);\nif (rows.length === 0) throw new Error('Die Match-CSV ist leer.');\n\nconst norm = (v) => String(v ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '');\nconst keys = Object.keys(rows[0]);\nconst findKey = (...aliases) => keys.find((k) => aliases.some((a) => norm(k) === norm(a)));\n\nconst dateKey = findKey('Datum', 'Date');\nconst homeKey = findKey('Heimteam', 'HomeTeam', 'Home Team');\nconst awayKey = findKey('Auswärtsteam', 'Auswaertsteam', 'AwayTeam', 'Away Team');\nconst scoreKey = findKey('Tore', 'Score');\nconst homeGoalsKey = findKey('Home Goals', 'HomeGoals', 'Goals Home', 'FTHG');\nconst awayGoalsKey = findKey('Away Goals', 'AwayGoals', 'Goals Away', 'FTAG');\nconst homeXgKey = findKey('Home xG', 'HomeXG', 'xG Home');\nconst awayXgKey = findKey('Away xG', 'AwayXG', 'xG Away');\n\nconst missing = [];\nif (!dateKey) missing.push('Datum/Date');\nif (!homeKey) missing.push('Heimteam/HomeTeam');\nif (!awayKey) missing.push('Auswärtsteam/AwayTeam');\nif (!scoreKey && !(homeGoalsKey && awayGoalsKey)) missing.push('Tore oder Home/Away Goals');\nif (!homeXgKey) missing.push('Home xG');\nif (!awayXgKey) missing.push('Away xG');\nif (missing.length) throw new Error(`Falsche Match-CSV: Pflichtspalten fehlen: ${missing.join(', ')}`);\n\nif (rows.length < 300) throw new Error(`Die Match-CSV enthält nur ${rows.length} Zeilen. Erwartet wird der vollständige Bundesliga-Datensatz 2025/26 (306 Spiele), keine Stichprobe.`);\n\nconst clubs = new Set();\nfor (const row of rows) { clubs.add(String(row[homeKey] ?? '').trim()); clubs.add(String(row[awayKey] ?? '').trim()); }\nclubs.delete('');\nif (clubs.size !== 18) throw new Error(`Die Match-CSV deckt ${clubs.size} Vereine ab; erwartet werden alle 18 Bundesliga-Vereine 2025/26.`);\n\nconst importedAt = new Date().toISOString();\nconst records = rows.map((row, index) => ({ dataset: 'matches', rowNumber: index + 1, sourceFile: 'bundesliga_2025_26_match_analytics.csv', importedAt, payload: JSON.stringify(row) }));\nreturn [{ json: { dataset: 'matches', rowCount: rows.length, clubCount: clubs.size, importedAt, records } }];"
      }
    },
