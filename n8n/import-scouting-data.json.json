    {
      "id": "6f9e88b8-80a3-4ca5-8cb7-97475d08fd7c",
      "name": "Match-CSV extrahieren",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        -656,
        48
