    {
      "id": "2d3a40a9-118b-410a-a415-e48a019deb63",
      "name": "Player-Daten validieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        320
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json);\nif (rows.length === 0) throw new Error('Die Player-CSV ist leer.');\n\nconst norm = (v) => String(v ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '');\nconst keys = Object.keys(rows[0]);\nconst findKey = (...aliases) => keys.find((k) => aliases.some((a) => norm(k) === norm(a)));\nconst playerKey = findKey('Player', 'Name');\nconst squadKey = findKey('Squad', 'Club', 'Team');\nconst positionKey = findKey('Position', 'Pos');\nconst ageKey = findKey('Age');\nconst minutesKey = findKey('Minutes', 'Min', 'Playing Time Min', 'minutesPlayed');\nconst missing = [];\nif (!playerKey) missing.push('Player');\nif (!squadKey) missing.push('Squad');\nif (!positionKey) missing.push('Position');\nif (!ageKey) missing.push('Age');\nif (!minutesKey) missing.push('Minutes');\nif (missing.length) throw new Error(`Falsche Player-CSV: Pflichtspalten fehlen: ${missing.join(', ')}`);\nif (rows.length < 2000) throw new Error(`Die Player-CSV enthält nur ${rows.length} Zeilen. Erwartet wird der vollständige 2025/26-Top-5-Ligen-Datensatz (~2.433 Spieler), keine Stichprobe.`);\nconst importedAt = new Date().toISOString();\nconst records = rows.map((row, index) => ({ dataset: 'players', rowNumber: index + 1, sourceFile: 'players_data-2025_2026-full.csv', importedAt, payload: JSON.stringify(row) }));\nreturn [{ json: { dataset: 'players', rowCount: rows.length, columnCount: keys.length, importedAt, records } }];"
      }
    },
